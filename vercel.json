{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "search.js",
      "use": "@vercel/node"
    },
    {
      "src": "find-technical.js",
      "use": "@vercel/node"
    },
    {
      "src": "analyze.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "dest": "/search.js"
    },
    {
      "src": "/api/find-technical",
      "dest": "/find-technical.js"
    },
    {
      "src": "/api/analyze",
      "dest": "/analyze.js"
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  ]
}
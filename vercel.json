{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "cloud-sync-core.js",
      "use": "@vercel/static"
    },
    {
      "src": "icon-192.png",
      "use": "@vercel/static"
    },
    {
      "src": "icon-512.png",
      "use": "@vercel/static"
    },
    {
      "src": "search.js",
      "use": "@vercel/node"
    },
    {
      "src": "find-technical.js",
      "use": "@vercel/node"
    },
    {
      "src": "analyze.js",
      "use": "@vercel/node"
    },
    {
      "src": "tariffe.js",
      "use": "@vercel/node"
    },
    {
      "src": "cloud-config.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "dest": "/search.js"
    },
    {
      "src": "/api/find-technical",
      "dest": "/find-technical.js"
    },
    {
      "src": "/api/analyze",
      "dest": "/analyze.js"
    },
    {
      "src": "/api/tariffe",
      "dest": "/tariffe.js"
    },
    {
      "src": "/api/cloud-config",
      "dest": "/cloud-config.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/icon-192.png",
      "dest": "/icon-192.png",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/icon-512.png",
      "dest": "/icon-512.png",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/cloud-sync-core.js",
      "dest": "/cloud-sync-core.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  ]
}